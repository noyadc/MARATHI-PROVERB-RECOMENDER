# Environment Variables Example for Marathi Proverb Recommendation System
# Copy this file to .env and configure your values.

# -------------------------------------------------------------
# OpenAI API Configuration (Required for AI Fallback)
# -------------------------------------------------------------
# Your OpenAI API key starting with sk-...
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI text generation model to use for Marathi proverb retrieval
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------------
# Recommendation & Fallback Threshold Configuration
# -------------------------------------------------------------
# Minimum similarity score (0.0 to 1.0) required to consider a dataset match relevant.
# If the best match in the dataset has similarity below this threshold, AI fallback activates.
# Default: 0.45 (Typical relevant situation: 0.45 - 0.70; Out-of-dataset: < 0.35)
SIMILARITY_THRESHOLD=0.45
